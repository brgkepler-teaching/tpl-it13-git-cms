---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const beitraege = await getCollection('beitraege');
  return beitraege.map((b) => ({ params: { id: b.id }, props: { beitrag: b } }));
}

const { beitrag } = Astro.props;
const { Content } = await render(beitrag);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={beitrag.data.title}>
  <p><a href={`${base}/`}>← Alle Beiträge</a></p>
  <article>
    <h1>{beitrag.data.title}</h1>
    <p class="meta">{beitrag.data.date.toLocaleDateString('de-AT')} • {beitrag.data.author} • {beitrag.data.kategorie}</p>
    <Content />
  </article>
</Base>
